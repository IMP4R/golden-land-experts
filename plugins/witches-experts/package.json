{
  "name": "witches-experts",
  "version": "0.1.0",
  "private": true,
  "description": "Golden Land witches: dual cheap/expensive routes, Memory Broker, shared experts. Isolated test profile only.",
  "type": "module",
  "scripts": {
    "build:client": "node ./build-client.mjs",
    "test:client-bundle": "node ./client-bundle.smoke.mjs",
    "test": "node --test ./test/broker.test.mjs ./test/agent-role.test.mjs ./test/store-guard.test.mjs ./test/history.test.mjs ./test/rlm.test.mjs ./test/rlm-code.test.mjs ./test/execution-cycle.test.mjs ./test/cycle-orchestrator.test.mjs ./test/execution-guard.test.mjs"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./broker": "./lib/broker.js",
    "./agent-role": "./lib/agent-role.js",
    "./store-guard": "./lib/store-guard.js",
    "./history": "./lib/history-plugin.js",
    "./rlm": "./lib/rlm-plugin.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.7",
    "react": "^18.2.0"
  }
}
